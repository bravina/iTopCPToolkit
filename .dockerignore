# Node dependencies — reinstalled inside the frontend-build stage.
node_modules/
frontend/node_modules/

# Frontend build output — regenerated by `npm run build` in the same stage.
frontend/dist/

# Version control and local agent/editor state.
.git/
.gitignore
.github/
.claude/
.devcontainer/

# Python environments and caches — the image runs Athena's own interpreter.
.venv/
venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.python-version
pyproject.toml
uv.lock

# Local-only helpers and OS cruft.
build_and_serve.sh
sec*en.sh
**/.DS_Store
